@model OutdoorShop.Models.Order

@{
    ViewData["Title"] = "Завършване на поръчката";
}

<div class="checkout-page">

    ```
    <div class="checkout-header">

        <span class="hero-badge">OUTDOORSHOP</span>

        <h1>📦 Завърши поръчката</h1>

        <p>
            Въведи данните си, за да завършиш покупката.
        </p>

    </div>


    <div class="checkout-container">

        <div class="checkout-form-card">

            <h2>👤 Данни за доставка</h2>

            <form asp-action="Checkout" method="post">

                <div class="form-group">

                    <label asp-for="CustomerName">
                        Име
                    </label>

                    <input asp-for="CustomerName"
                           class="form-control"
                           placeholder="Твоето име" />

                    <span asp-validation-for="CustomerName"
                          class="text-danger"></span>

                </div>


                <div class="form-group">

                    <label asp-for="Email">
                        Email
                    </label>

                    <input asp-for="Email"
                           type="email"
                           class="form-control"
                           placeholder="example@email.com" />

                    <span asp-validation-for="Email"
                          class="text-danger"></span>

                </div>


                <div class="form-group">

                    <label asp-for="Phone">
                        Телефон
                    </label>

                    <input asp-for="Phone"
                           class="form-control"
                           placeholder="0888 123 456" />

                    <span asp-validation-for="Phone"
                          class="text-danger"></span>

                </div>


                <div class="form-group">

                    <label asp-for="Address">
                        Адрес за доставка
                    </label>

                    <textarea asp-for="Address"
                              class="form-control"
                              rows="4"
                              placeholder="Град, улица, номер..."></textarea>

                    <span asp-validation-for="Address"
                          class="text-danger"></span>

                </div>


                <button type="submit"
                        class="btn btn-success checkout-submit">
                    🔒 Потвърди поръчката
                </button>

                <a asp-controller="Cart"
                   asp-action="Index"
                   class="checkout-back">
                    ← Назад към количката
                </a>

            </form>

        </div>


        <div class="checkout-info">

            <div class="checkout-info-card">

                <div class="checkout-info-icon">
                    🏕️
                </div>

                <h3>
                    Готов за приключение?
                </h3>

                <p>
                    След потвърждаване на поръчката
                    ще обработим данните ти и ще се свържем
                    с теб за доставката.
                </p>

                <div class="checkout-feature">
                    ✓ Сигурна поръчка
                </div>

                <div class="checkout-feature">
                    ✓ Бърза обработка
                </div>

                <div class="checkout-feature">
                    ✓ Outdoor екипировка
                </div>

            </div>

        </div>

    </div>
    ```

</div>
