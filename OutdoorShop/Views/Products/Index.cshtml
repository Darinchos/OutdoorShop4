@model IEnumerable<OutdoorShop.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<div class="products-page">

    ```
    <div class="products-header">

        <div>
            <span class="hero-badge">OUTDOORSHOP</span>

            <h1>🛍️ Нашите продукти</h1>

            <p>
                Екипировка за планина, къмпинг и следващото ти приключение.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-success">
            ➕ Добави продукт
        </a>

    </div>


    @if (!Model.Any())
    {
        <div class="empty-state">

            <div class="empty-icon">🏕️</div>

            <h2>Все още няма продукти</h2>

            <p>
                Добави първия продукт към OutdoorShop.
            </p>

            <a asp-action="Create"
               class="btn btn-success">
                ➕ Добави продукт
            </a>

        </div>
    }
    else
    {
        <div class="product-grid">

            @foreach (var product in Model)
            {
                <div class="product-card">

                    <div class="product-image-container">

                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl"
                                 class="product-image"
                                 alt="@product.Name" />
                        }
                        else
                        {
                            <div class="product-placeholder">
                                🏕️
                            </div>
                        }

                        @if (product.Stock <= 0)
                        {
                            <span class="stock-badge out">
                                Изчерпан
                            </span>
                        }
                        else if (product.Stock <= 5)
                        {
                            <span class="stock-badge low">
                                Само @product.Stock
                            </span>
                        }
                        else
                        {
                            <span class="stock-badge">
                                В наличност
                            </span>
                        }

                    </div>


                    <div class="product-content">

                        @if (product.Category != null)
                        {
                            <span class="product-category">
                                @product.Category.Name
                            </span>
                        }

                        <h2>
                            @product.Name
                        </h2>

                        <p class="product-description">
                            @product.Description
                        </p>


                        <div class="product-bottom">

                            <div class="product-price">
                                @product.Price.ToString("0.00") лв.
                            </div>

                        </div>


                        <div class="product-actions">

                            @if (product.Stock > 0)
                            {
                                <form asp-controller="Cart"
                                      asp-action="Add"
                                      method="post">

                                    <input type="hidden"
                                           name="productId"
                                           value="@product.Id" />

                                    <button type="submit"
                                            class="btn btn-success w-100">
                                        🛒 Добави в количката
                                    </button>

                                </form>
                            }
                            else
                            {
                                <button class="btn btn-secondary w-100"
                                        disabled>
                                    Изчерпан
                                </button>
                            }

                        </div>


                        <div class="admin-actions">

                            <a asp-action="Edit"
                               asp-route-id="@product.Id"
                               class="btn btn-sm btn-primary">
                                ✏️
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@product.Id"
                               class="btn btn-sm btn-danger">
                                🗑️
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    ```

</div>
