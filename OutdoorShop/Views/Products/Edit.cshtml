@model OutdoorShop.Models.Product

@{
    ViewData["Title"] = "Редактиране на продукт";
}

<div class="container mt-4">

    <h1>✏️ Редактиране на продукт</h1>

    <form asp-action="Edit" method="post">

        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="Name" class="form-label">
                Име на продукта
            </label>

            <input asp-for="Name"
                   class="form-control" />

            <span asp-validation-for="Name"
                  class="text-danger"></span>
        </div>


        <div class="mb-3">
            <label asp-for="Description" class="form-label">
                Описание
            </label>

            <textarea asp-for="Description"
                      class="form-control"
                      rows="4"></textarea>

            <span asp-validation-for="Description"
                  class="text-danger"></span>
        </div>


        <div class="mb-3">
            <label asp-for="Price" class="form-label">
                Цена
            </label>

            <input asp-for="Price"
                   type="number"
                   step="0.01"
                   class="form-control" />

            <span asp-validation-for="Price"
                  class="text-danger"></span>
        </div>


        <div class="mb-3">
            <label asp-for="Stock" class="form-label">
                Наличност
            </label>

            <input asp-for="Stock"
                   type="number"
                   min="0"
                   class="form-control" />

            <span asp-validation-for="Stock"
                  class="text-danger"></span>
        </div>


        <div class="mb-3">
            <label asp-for="ImageUrl" class="form-label">
                URL на снимката
            </label>

            <input asp-for="ImageUrl"
                   class="form-control" />

            <span asp-validation-for="ImageUrl"
                  class="text-danger"></span>
        </div>


        <div class="mb-3">
            <label asp-for="CategoryId" class="form-label">
                Категория
            </label>

            <select asp-for="CategoryId"
                    class="form-select">

                @foreach (var category in ViewBag.Categories)
                {
                    <option value="@category.Id">
                        @category.Name
                    </option>
                }

            </select>

            <span asp-validation-for="CategoryId"
                  class="text-danger"></span>
        </div>


        <button type="submit"
                class="btn btn-primary">
            💾 Запази промените
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Отказ
        </a>

    </form>

</div>