@{
    ViewData["Title"] = "OutdoorShop";
}

<div class="hero-section">

    <div class="hero-content">

        <span class="hero-badge">
            🌲 EXPLORE • ADVENTURE • OUTDOOR
        </span>

        <h1>
            Gear up for your
            <span>next adventure.</span>
        </h1>

        <p>
            Качествена екипировка за туризъм,
            къмпинг и приключения на открито.
        </p>

        <div class="hero-buttons">

            <a asp-controller="Products"
               asp-action="Index"
               class="btn btn-success btn-lg">
                🛍️ Разгледай продуктите
            </a>

            <a asp-controller="Categories"
               asp-action="Index"
               class="btn btn-outline-dark btn-lg">
                🏷️ Категории
            </a>

        </div>

    </div>

</div>


<div class="container mt-5">

    <div class="text-center mb-5">

        <span class="hero-badge">
            WHY OUTDOORSHOP?
        </span>

        <h2 class="mt-2">
            Всичко за следващото ти приключение
        </h2>

    </div>


    <div class="row g-4">

        <div class="col-md-4">

            <div class="feature-card">

                <div class="feature-icon">
                    🏕️
                </div>

                <h3>
                    Outdoor Gear
                </h3>

                <p>
                    Екипировка, на която можеш да разчиташ
                    по време на твоите приключения.
                </p>

            </div>

        </div>


        <div class="col-md-4">

            <div class="feature-card">

                <div class="feature-icon">
                    🥾
                </div>

                <h3>
                    За всяко приключение
                </h3>

                <p>
                    Туризъм, къмпинг, планина и всичко
                    между тях.
                </p>

            </div>

        </div>


        <div class="col-md-4">

            <div class="feature-card">

                <div class="feature-icon">
                    🌲
                </div>

                <h3>
                    Готов за природата
                </h3>

                <p>
                    Подготви се и излез навън.
                    Следващото приключение те чака.
                </p>

            </div>

        </div>

    </div>

</div>